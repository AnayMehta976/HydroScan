# ---------------------------------------------------------------------------
# HydroScan .gitignore  (detection system only)
# ---------------------------------------------------------------------------

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python
venv/
env/
.venv/
ENV/

# --- Runtime output (regenerated every scan) ---
data/captures/*
data/results/*
data/samples/*
!data/captures/.gitkeep
!data/results/.gitkeep
!data/samples/.gitkeep
*.log
reset_test.jpg

# --- Synthetic ML dataset (regenerate with scripts/generate_ml_dataset.py) ---
# ml/model.joblib and ml/features.csv ARE committed so the app works on a fresh
# clone. The 500 generated images are not (large + reproducible).
ml/dataset/

# --- Phone app / website / networking  (EXCLUDED from this repo) ---
android/
web/
hydroscan/server.py
hydroscan/controller.py
scripts/ble_service.py
scripts/setup_hotspot.sh
systemd/hydroscan-ble.service

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
